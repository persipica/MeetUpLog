# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 반드시 포함되어 있어야 합니다).
# 변수명은 pydantic-settings가 대소문자 구분 없이 config.Settings 필드에
# 매핑합니다 (예: TMDB_API_KEY -> settings.tmdb_api_key).

# --- TMDB (v3 api_key 또는 v4 Bearer 토큰 중 하나만 있으면 됨) ---------------
TMDB_API_KEY=
TMDB_API_TOKEN=

# --- KOFIC/KOBIS (관람등급 보강, collectors.collect_kobis) -------------------
KOBIS_API_KEY=

# --- MySQL (MEETUP_DB_BACKEND=mysql일 때만 필요) -----------------------------
# 기본값은 sqlite이므로 로컬 개발 시엔 아래를 비워둬도 됩니다.
# 운영/스테이징에서 MySQL을 쓰려면 MEETUP_DB_BACKEND=mysql로 바꾸고
# 아래 세 값(DATABASE/USER/PASSWORD)을 반드시 채우세요 - 비어 있으면
# config.Settings.require_mysql()이 서버 기동 시점에 명확한 에러를 냅니다.
MEETUP_DB_BACKEND=sqlite
MEETUP_MYSQL_HOST=localhost
MEETUP_MYSQL_PORT=3306
MEETUP_MYSQL_DATABASE=
MEETUP_MYSQL_USER=
MEETUP_MYSQL_PASSWORD=

# --- Hugging Face (SBERT 인코더 등, 선택) ------------------------------------
HF_TOKEN=

# --- 무거운 로컬 보정 모델 (기본 off - 실시간 채팅 경로에 수 초씩 걸림) -------
MEETUP_USE_TYPO_MODEL=false
MEETUP_USE_SPACER_MODEL=false
MEETUP_REALTIME_HEAVY_CORRECTION=false
