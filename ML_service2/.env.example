# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 이미 포함되어 있어야 합니다).

TMDB_API_KEY=
KOFIC_API_KEY=
# huggingface.co/settings/tokens 에서 발급한 토큰. ENABLE_SBERT_SIMILARITY=true
# 로 켰을 때 SBERT(jhgan/ko-sroberta-multitask) HF Inference API 호출에
# 쓰인다 - text_normalization.SentenceEmbedder 참고. 토큰을 코드에 직접
# 적지 말고 반드시 여기(.env, 커밋 안 됨)에만 넣을 것.
HF_TOKEN=

# 아래는 선택 사항 (기본값 false). text_normalization.py 참고.
# ENABLE_SBERT_SIMILARITY=true + HF_TOKEN만 있으면 됨 - requests로 HF
# Inference API를 호출하는 경량 경로가 기본이라 torch 등은 필요 없다.
ENABLE_TYPO_CORRECTION=false
ENABLE_SPACING_CORRECTION=false
ENABLE_SBERT_SIMILARITY=false

# 관련성 분류기를 KcELECTRA 파인튜닝 결과로 교체 (기본값 false).
# 로컬 체크포인트가 TRANSFORMER_RELEVANCE_MODEL_DIR에 없으면 자동으로
# TF-IDF+LogisticRegression으로 폴백한다. relevance_classifier.py 참고.
ENABLE_TRANSFORMER_RELEVANCE_CLASSIFIER=false
TRANSFORMER_RELEVANCE_MODEL_NAME=beomi/KcELECTRA-base-v2022
TRANSFORMER_RELEVANCE_MODEL_DIR=./checkpoints/relevance-kcelectra

# State(UserPreferenceState/ConversationFocus)를 Redis에 라운드 단위로
# 저장 (기본값 false=인메모리). state_store.py 참고.
ENABLE_REDIS_STATE_STORE=false
REDIS_URL=redis://localhost:6379/0
STATE_TTL_SECONDS=21600
