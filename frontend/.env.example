# 배포 환경에서 API 서버가 다른 도메인일 때만 설정하세요.
# 로컬 개발은 vite.config.js의 /api -> http://localhost:8080 프록시를 사용합니다.
VITE_API_BASE_URL=/api

# 실제 Spring Boot 인증 API를 사용합니다.
# 화면만 확인할 때 로컬 데모 인증으로 되돌리려면 true로 변경하세요.
VITE_USE_MOCK_AUTH=false

# 카카오 OAuth 시작 주소가 기본 Spring Security 경로와 다를 때만 설정하세요.
# VITE_KAKAO_AUTH_URL=/oauth2/authorization/kakao
